{
  "name": "luogu-teaching-assistant",
  "displayName": "洛谷教学助手",
  "description": "信息学奥赛教学助手：单文件一键编译运行、洛谷抓题建题与样例评测、提交代码、题面白板批注、代码转图片。",
  "version": "0.1.12",
  "publisher": "lgassist",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "OI",
    "竞赛",
    "信息学奥赛",
    "C++",
    "洛谷",
    "luogu",
    "题库"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:c",
    "onView:lgAssist.sidebar"
  ],
  "contributes": {
    "configuration": {
      "title": "洛谷教学助手",
      "properties": {
        "lgAssist.compile.command": {
          "type": "string",
          "default": "g++",
          "description": "编译器命令。Windows 上 g++ 不在 PATH 里时可填完整路径，例如 C:\\msys64\\mingw64\\bin\\g++.exe。"
        },
        "lgAssist.compile.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-O2",
            "-std=c++17",
            "-pipe",
            "-Wall"
          ],
          "description": "编译参数。会追加 -o 与源文件路径。"
        },
        "lgAssist.terminal.mode": {
          "type": "string",
          "enum": [
            "integrated",
            "external"
          ],
          "enumDescriptions": [
            "在 VSCode 集成终端中运行",
            "在外部终端中运行（Linux/macOS 如 gnome-terminal；Windows 新开 cmd 控制台窗口）"
          ],
          "default": "integrated",
          "description": "一键编译运行（F6）时使用的终端类型。"
        },
        "lgAssist.terminal.externalCommand": {
          "type": "string",
          "default": "",
          "description": "外置终端启动命令模板，留空则自动选择（Linux/macOS 探测已有终端，Windows 用 cmd 的 start 新开窗口）。可用占位符 ${exe}（可执行文件路径）、${dir}（文件所在目录）、${file}（源文件路径）；替换时会按平台自动加引号，模板里不要再包一层引号。Linux/macOS 例：gnome-terminal -- bash -lc 'cd ${dir} && ${exe}'; Windows 例（cmd 语法）：wt -d ${dir} cmd /k ${exe}"
        },
        "lgAssist.terminal.keepOpen": {
          "type": "boolean",
          "default": true,
          "description": "程序运行结束后保留终端窗口，便于查看输出。"
        },
        "lgAssist.terminal.clearBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "运行前清屏。"
        },
        "lgAssist.judge.timeoutMs": {
          "type": "number",
          "default": 10000,
          "description": "单个样例运行的时间限制（毫秒），超时判为 TLE。"
        },
        "lgAssist.judge.maxOutputBytes": {
          "type": "number",
          "default": 16777216,
          "description": "单个样例输出上限（字节），超出后截断。"
        },
        "lgAssist.problems.bankDir": {
          "type": "string",
          "default": "题库",
          "description": "创建题目文件的目录（相对工作区根）。"
        },
        "lgAssist.problems.saveStatementAsMd": {
          "type": "boolean",
          "default": true,
          "description": "创建题目时把题面保存为同目录下的 <题号>.md 文件。"
        },
        "lgAssist.problems.codeTemplate": {
          "type": "string",
          "default": "#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n\n  return 0;\n}\n",
          "description": "新建题目源文件的初始代码模板。建议缩进与你的 editor.tabSize 一致：模板内容会让 VSCode 的缩进探测（editor.detectIndentation，默认开）猜出新建文件的 tabSize，不一致时状态栏显示的缩进就不是你设的值。"
        },
        "lgAssist.problems.openStatement": {
          "type": "string",
          "enum": [
            "webview",
            "markdown",
            "none"
          ],
          "enumDescriptions": [
            "在内置面板中渲染（支持公式）",
            "打开保存的 .md 文件预览",
            "不自动打开"
          ],
          "default": "webview",
          "description": "创建题目后自动打开题面的方式。"
        },
        "lgAssist.whiteboard.exportDpi": {
          "type": "number",
          "default": 150,
          "minimum": 72,
          "maximum": 600,
          "description": "白板与知识面板「导出 A4 PNG」的分辨率（dpi）。默认 150（A4 → 1240×1754），当讲义发群里够用、体积约为 300dpi 的四分之一；要打印精细件可改成 300（A4 → 2480×3508）。"
        },
        "lgAssist.submit.language": {
          "type": "string",
          "default": "cpp",
          "enum": [
            "cpp",
            "cpp98",
            "cpp11",
            "cpp14",
            "cpp14gcc9",
            "cpp17",
            "cpp20",
            "cpp23",
            "c",
            "pascal",
            "python3",
            "pypy3",
            "java8",
            "java21",
            "rust",
            "go"
          ],
          "enumDescriptions": [
            "C++14（默认，id 11 —— 与洛谷网页提交框的默认值一致）",
            "C++98（id 3）",
            "C++11（id 4）",
            "C++14（id 11）",
            "C++14 (GCC 9)（id 28）",
            "C++17（id 12）",
            "C++20（id 27）",
            "C++23（id 34）",
            "C（id 2）",
            "Pascal（id 1）",
            "Python 3（id 7）",
            "PyPy 3（id 25）",
            "Java 8（id 8）",
            "Java 21（id 33）",
            "Rust（id 15）",
            "Go（id 14）"
          ],
          "description": "提交到洛谷时使用的语言。洛谷提交接口的 lang 是**数字 id**（不是 cpp 这种字符串），这里填的是人话别名，扩展会查表换成 id；也可以直接填数字（如 34 = C++23）。别名与 id 取自站点自己的 GET /_lfe/config（CodeLanguage 枚举），默认值与洛谷网页提交框一致（网页默认 lang=11 = C++14）。"
        },
        "lgAssist.submit.enableO2": {
          "type": "boolean",
          "default": true,
          "description": "提交时是否开启 O2 优化（对应请求体的 enableO2）。默认与洛谷网页一致（开）。关掉能少一类「本地能过、洛谷不过」的讲评难题 —— O2 偶尔会改变未定义行为的实际表现。"
        },
        "lgAssist.banshu.enabled": {
          "type": "boolean",
          "default": true,
          "description": "题解板书：建题时自动生成 Typst 题解文档（题解板书.typ），并在题库根目录放一份共享版式。关掉后白板工具栏也不再显示「导出并插入题解」。"
        },
        "lgAssist.banshu.confDir": {
          "type": "string",
          "default": "",
          "description": "题解共享版式 banshuconf.typ 所在的目录。留空 = 题库根目录（即 <工作区>/<lgAssist.problems.bankDir>）。各题目录用 `#import \"../banshuconf.typ\"` 引它，所以编译时 typst 的 --root 会放宽到工作区。"
        },
        "lgAssist.banshu.author": {
          "type": "string",
          "default": "爱学习的咸鱼君",
          "description": "题解标题区显示的署名。默认「爱学习的咸鱼君」；改成别的名字即可，留空则不显示署名栏（只留日期）。"
        },
        "lgAssist.banshu.course": {
          "type": "string",
          "default": "《深入浅出程序设计竞赛》题解",
          "description": "题解眉行与页眉里的课程名。"
        },
        "lgAssist.banshu.typstPath": {
          "type": "string",
          "default": "typst",
          "description": "typst 可执行文件。默认从 PATH 里找；装了但不在 PATH 时填完整路径（如 C:\\\\Users\\\\me\\\\scoop\\\\shims\\\\typst.exe）。"
        },
        "lgAssist.banshu.imageWidth": {
          "type": "string",
          "default": "89%",
          "description": "板书图在题解里的宽度（Typst 长度表达式，如 89% 或 16cm）。多页会逐页按这个宽度插入。"
        },
        "lgAssist.cover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "建题时自动生成题目封面（调 BiliBiliHelper，落进题目录里的 <题号> 封面.png）。没装 BiliBiliHelper 的机器不用管：它会静默跳过，只在输出面板留一行日志（关掉这一项连日志也没有）。"
        },
        "lgAssist.cover.command": {
          "type": "string",
          "default": "bili-helper",
          "description": "封面生成命令（BiliBiliHelper 的 CLI）。默认从 PATH 找 bili-helper；装了但不在 PATH 时填可执行文件完整路径，例如 C:\\\\Users\\\\me\\\\BiliBiliHelper\\\\.venv\\\\Scripts\\\\bili-helper.exe。也可以用 args + projectDir 走「python 跑源码」，见那两项。"
        },
        "lgAssist.cover.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "封面命令的前缀参数。用源码方式跑时填 [\"-m\", \"bili_assistant.cli\"]，并把 command 设成 python、projectDir 指向 BiliBiliHelper 项目根。"
        },
        "lgAssist.cover.projectDir": {
          "type": "string",
          "default": "",
          "description": "封面命令的工作目录。**用 `python -m bili_assistant.cli` 时必须填 BiliBiliHelper 的项目根目录** —— 否则 python 找不到 bili_assistant 包（ModuleNotFoundError）。用 bili-helper.exe 时可以留空。"
        },
        "lgAssist.cover.template": {
          "type": "string",
          "default": "",
          "description": "封面模板（series / dark-tech / minimal）。留空 = 用 BiliBiliHelper 自己 config.toml 里的默认。"
        },
        "lgAssist.cover.palette": {
          "type": "string",
          "default": "",
          "description": "封面配色（blue / purple / warm / dark）。留空 = 用 BiliBiliHelper 的默认。"
        },
        "lgAssist.cover.size": {
          "type": "string",
          "default": "",
          "description": "封面尺寸，如 1146x717（B 站封面比例）。留空 = 用 BiliBiliHelper 的默认。"
        },
        "lgAssist.cover.fileName": {
          "type": "string",
          "default": "${id} 封面.png",
          "description": "封面文件名模板，${id} 会换成题号。默认与题解目录里的 <题号> 板书.png 同一套命名。"
        },
        "lgAssist.cover.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "追加到封面命令行末尾的原始参数，例如 [\"--ai-bg\"] 开 AI 背景（**按次计费**）、[\"--refresh\"] 忽略缓存重新抓题面。同名的后出现的胜出。"
        },
        "lgAssist.cover.timeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "生成封面的超时时间（毫秒）。一张要起一次 Playwright，冷启动十几秒是正常的；下限 5 秒。"
        },
        "lgAssist.submit.compileFirst": {
          "type": "boolean",
          "default": true,
          "description": "提交前先本地编译，编译不通过则不提交。"
        },
        "lgAssist.submit.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "description": "提交后查询评测结果的间隔（毫秒）。"
        },
        "lgAssist.submit.pollTimeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "提交后等待评测结果的最长时间（毫秒）。"
        },
        "lgAssist.luogu.baseUrl": {
          "type": "string",
          "default": "https://www.luogu.com.cn",
          "description": "洛谷站点根地址。"
        },
        "lgAssist.luogu.requestIntervalMs": {
          "type": "number",
          "default": 800,
          "description": "两次站点请求之间的最小间隔（毫秒），串行节流。洛谷有频控，调小有被风控的风险。"
        }
      }
    },
    "commands": [
      {
        "command": "lgAssist.compileRun",
        "category": "洛谷助手",
        "title": "编译并运行当前文件",
        "icon": "$(play)"
      },
      {
        "command": "lgAssist.runSamples",
        "category": "洛谷助手",
        "title": "编译并用样例评测当前文件",
        "icon": "$(beaker)"
      },
      {
        "command": "lgAssist.login",
        "category": "洛谷助手",
        "title": "登录洛谷账号（粘贴 Cookie）",
        "icon": "$(account)"
      },
      {
        "command": "lgAssist.logout",
        "category": "洛谷助手",
        "title": "退出洛谷登录"
      },
      {
        "command": "lgAssist.searchAndCreate",
        "category": "洛谷助手",
        "title": "搜索洛谷题目并创建文件"
      },
      {
        "command": "lgAssist.createFromProblem",
        "category": "洛谷助手",
        "title": "按题号创建文件"
      },
      {
        "command": "lgAssist.openProblemById",
        "category": "洛谷助手",
        "title": "打开题号对应的题面"
      },
      {
        "command": "lgAssist.clearRecents",
        "category": "洛谷助手",
        "title": "清空最近题目"
      },
      {
        "command": "lgAssist.showCurrentFileHelp",
        "category": "洛谷助手",
        "title": "当前文件关联说明"
      },
      {
        "command": "lgAssist.openStatement",
        "category": "洛谷助手",
        "title": "打开当前题目的题面",
        "icon": "$(book)"
      },
      {
        "command": "lgAssist.submit",
        "category": "洛谷助手",
        "title": "提交当前文件到洛谷",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "lgAssist.openWhiteboard",
        "category": "洛谷助手",
        "title": "打开题面白板（批注）",
        "icon": "$(edit)"
      },
      {
        "command": "lgAssist.openKnowledgeBoard",
        "category": "洛谷助手",
        "title": "打开知识面板（空白讲解）",
        "icon": "$(lightbulb)"
      },
      {
        "command": "lgAssist.exportImage",
        "category": "洛谷助手",
        "title": "导出当前文件为图片",
        "icon": "$(file-media)"
      },
      {
        "command": "lgAssist.createBanshuDoc",
        "category": "洛谷助手",
        "title": "生成/打开题解板书",
        "icon": "$(book)"
      },
      {
        "command": "lgAssist.insertBanshuCode",
        "category": "洛谷助手",
        "title": "把当前代码写进题解",
        "icon": "$(code)"
      },
      {
        "command": "lgAssist.exportBanshuPdf",
        "category": "洛谷助手",
        "title": "导出题解 PDF",
        "icon": "$(file-pdf)"
      },
      {
        "command": "lgAssist.writeBanshuConf",
        "category": "洛谷助手",
        "title": "写入/重建题解共享版式",
        "icon": "$(settings-gear)"
      },
      {
        "command": "lgAssist.createCover",
        "category": "洛谷助手",
        "title": "生成题目封面（BiliBiliHelper）",
        "icon": "$(device-camera)"
      },
      {
        "command": "lgAssist.refresh",
        "category": "洛谷助手",
        "title": "刷新侧边栏",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lgAssist.compileRun",
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx || resourceExtname == .c",
          "group": "navigation@1"
        },
        {
          "command": "lgAssist.runSamples",
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx || resourceExtname == .c",
          "group": "navigation@2"
        },
        {
          "command": "lgAssist.submit",
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx || resourceExtname == .c",
          "group": "navigation@3"
        },
        {
          "command": "lgAssist.exportImage",
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx || resourceExtname == .c",
          "group": "navigation@4"
        },
        {
          "command": "lgAssist.createBanshuDoc",
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx || resourceExtname == .c",
          "group": "navigation@5"
        },
        {
          "command": "lgAssist.exportBanshuPdf",
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx || resourceExtname == .c",
          "group": "navigation@6"
        }
      ],
      "explorer/context": [
        {
          "command": "lgAssist.exportImage",
          "when": "resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx || resourceExtname == .c",
          "group": "lgassist@1"
        }
      ],
      "view/title": [
        {
          "command": "lgAssist.refresh",
          "when": "view == lgAssist.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "lgAssist.login",
          "when": "view == lgAssist.sidebar",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "lgAssist.openProblemById",
          "when": "false"
        },
        {
          "command": "lgAssist.showCurrentFileHelp",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lgAssist.compileRun",
        "key": "f6",
        "when": "editorTextFocus && (resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx || resourceExtname == .c)"
      },
      {
        "command": "lgAssist.runSamples",
        "key": "ctrl+f6",
        "when": "editorTextFocus && (resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx || resourceExtname == .c)"
      },
      {
        "command": "lgAssist.submit",
        "key": "ctrl+alt+s",
        "when": "editorTextFocus && (resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx || resourceExtname == .c)"
      },
      {
        "command": "lgAssist.exportImage",
        "key": "ctrl+alt+p",
        "when": "editorTextFocus && (resourceExtname == .cpp || resourceExtname == .cc || resourceExtname == .cxx || resourceExtname == .c)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lgAssist",
          "title": "洛谷教学助手",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "lgAssist": [
        {
          "id": "lgAssist.sidebar",
          "name": "题目与账号",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ./ && tsc --noEmit -p tsconfig.webview.json",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "node esbuild.test.js && node --test test-dist/*.test.js",
    "test:smoke": "node esbuild.js --production && node test/smoke-activate.cjs",
    "verify": "npm run typecheck && npm test && npm run test:smoke",
    "package": "npm run typecheck && node esbuild.js --production && node test/smoke-activate.cjs && vsce package --no-dependencies"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}